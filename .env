# ============================================
# CONFIGURACIÓN DE SEGURIDAD - NO COMMITIR ESTE ARCHIVO
# ============================================

# --------------------------------------------
# JWT y Autenticación
# --------------------------------------------
# Generar con: openssl rand -hex 32
SECRET_KEY=7284ec8675c58c9bf2e7667613bd359526bbf66bc9871c02d6bed4f0319d914a
# Token de un solo uso lógico para registrar el primer administrador
# Generar con: openssl rand -hex 32
BOOTSTRAP_TOKEN=07d8d66899e64fbc1780c8a20609a9272f0dfa5ca65182a7ef5eb29a5809e2e4
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --------------------------------------------
# Encriptación de Base de Datos
# --------------------------------------------
# Generar con: openssl rand -hex 32 (64 caracteres hex)
DATABASE_ENCRYPTION_KEY=6d50bf8a3559eeab796885bb59a2547c2058385e002a7ae9db4923e54bb766a3
DATABASE_URL=sqlite+pysqlcipher:///./secure.db
TLS_ENABLED=false

# --------------------------------------------
# Configuración de Cámara
# --------------------------------------------
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
FACE_DETECTION_MODEL=hog  # o cnn para mayor precisión (más lento)
FACE_RECOGNITION_TOLERANCE=0.6  # Menor = más estricto

# --------------------------------------------
# Detección de Animales (YOLOv8)
# --------------------------------------------
YOLO_MODEL=yolov8n.pt  # yolov8n, yolov8s, yolov8m, yolov8l, yolov8x
ANIMAL_CONFIDENCE_THRESHOLD=0.5
ANIMAL_CLASSES=dog,cat,bird,horse  # Clases a detectar

# --------------------------------------------
# Seguridad IoT
# --------------------------------------------
TLS_ENABLED=true
TLS_CERT_PATH=./certs/server.crt
TLS_KEY_PATH=./certs/server.key
RATE_LIMIT_PER_MINUTE=60
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# --------------------------------------------
# Liveness Detection
# --------------------------------------------
LIVENESS_ENABLED=true
LIVENESS_BLINK_THRESHOLD=0.3
LIVENESS_HEAD_MOVEMENT_THRESHOLD=0.5

# --------------------------------------------
# Logs y Auditoría
# --------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=./logs/audit.log
LOG_RETENTION_DAYS=365
LOG_INTEGRITY_HASH=true

# --------------------------------------------
# Dashboard y Frontend
# --------------------------------------------
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --------------------------------------------
# Configuración de Servidor
# --------------------------------------------
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=false

# --------------------------------------------
# Alertas y Notificaciones
# --------------------------------------------
ALERT_EMAIL=
ALERT_WEBHOOK_URL=
MAX_UNAUTHORIZED_ATTEMPTS=3
ALERT_ON_ANIMAL_DETECTION=true
